# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://dhdnvqsqmfzxkrwbkbxc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_...) — server only. NEVER prefix with NEXT_PUBLIC_.
# Needed for creating staff logins. Add it in Vercel → Settings → Environment Variables.
SUPABASE_SECRET_KEY=sb_secret_...
# Staff log in with a username; Supabase Auth stores it as <username>@<this domain>.
# Don't change after accounts exist.
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=staff.finote-tsidk.app
